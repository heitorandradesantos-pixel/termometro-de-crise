 64.65, "não?", 1.0]]}, {"ini": 65.33, "fim": 67.33, "texto": "Imagina só, não, mas nós zeramos o imposto", "palavras": [[65.33, 65.61, "Imagina", 0.99], [65.65, 65.75, "só,", 0.98], [65.81, 66.05, "não,", 0.99], [66.11, 66.21, "mas", 1.0], [66.25, 66.45, "nós", 0.99], [66.47, 66.71, "zeramos", 0.8], [66.71, 66.73, "o", 1.0], [66.75, 67.33, "imposto", 1.0]]}, {"ini": 67.71, "fim": 70.09, "texto": "O preço não caiu porque eles não derrubaram o preço", "palavras": [[67.71, 67.73, "O", 1.0], [67.79, 68.03, "preço", 1.0], [68.05, 68.15, "não", 1.0], [68.19, 68.49, "caiu", 1.0], [68.53, 68.75, "porque", 0.98], [68.85, 69.03, "eles", 1.0], [69.05, 69.15, "não", 1.0], [69.17, 69.61, "derrubaram", 1.0], [69.61, 69.63, "o", 1.0], [69.69, 70.09, "preço", 1.0]]}, {"ini": 70.11, "fim": 71.19, "texto": "Mas o imposto nós zeramos", "palavras": [[70.11, 70.25, "Mas", 1.0], [70.27, 70.29, "o", 1.0], [70.33, 70.69, "imposto", 1.0], [70.73, 70.85, "nós", 1.0], [70.89, 71.19, "zeramos", 0.8]]}, {"ini": 71.77, "fim": 73.34, "texto": "É isso que eles querem fazer, meu povo", "palavras": [[71.77, 71.79, "É", 0.99], [71.89, 72.03, "isso", 1.0], [72.03, 72.09, "que", 1.0], [72.11, 72.21, "eles", 1.0], [72.25, 72.46, "querem", 1.0], [72.5, 72.8, "fazer,", 1.0], [72.86, 72.96, "meu", 1.0], [73.04, 73.34, "povo", 1.0]]}, {"ini": 73.8, "fim": 75.14, "texto": "Vamos acordar, comenta aqui embaixo", "palavras": [[73.8, 73.94, "Vamos", 0.97], [73.96, 74.32, "acordar,", 1.0], [74.36, 74.64, "comenta", 1.0], [74.66, 74.76, "aqui", 1.0], [74.76, 75.14, "embaixo", 0.99]]}, {"ini": 75.16, "fim": 76.24, "texto": "Veja o que você acha disso", "palavras": [[75.16, 75.32, "Veja", 0.79], [75.32, 75.34, "o", 1.0], [75.34, 75.42, "que", 1.0], [75.44, 75.58, "você", 1.0], [75.68, 75.86, "acha", 1.0], [75.92, 76.24, "disso", 1.0]]}]