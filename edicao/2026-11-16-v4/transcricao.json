 1.0]]}, {"ini": 71.22, "fim": 73.22, "texto": "Nós tínhamos 1 dólar a 4,98", "palavras": [[71.22, 71.36, "Nós", 1.0], [71.42, 71.7, "tínhamos", 1.0], [71.74, 71.8, "1", 0.61], [71.84, 72.1, "dólar", 0.97], [72.12, 72.14, "a", 0.99], [72.2, 72.42, "4", 0.93], [72.46, 73.22, ",98", 1.0]]}, {"ini": 74.22, "fim": 75.64, "texto": "Quem teve oportunidade de comprar", "palavras": [[74.22, 74.34, "Quem", 0.97], [74.38, 74.54, "teve", 1.0], [74.58, 75.16, "oportunidade", 0.9], [75.18, 75.24, "de", 0.93], [75.3, 75.64, "comprar", 0.52]]}, {"ini": 75.68, "fim": 77.2, "texto": "Quem não teve, está hoje querendo comprar", "palavras": [[75.68, 75.8, "Quem", 0.75], [75.82, 75.92, "não", 1.0], [76.0, 76.22, "teve,", 1.0], [76.24, 76.34, "está", 0.98], [76.42, 76.62, "hoje", 1.0], [76.64, 76.88, "querendo", 0.98], [76.9, 77.2, "comprar", 1.0]]}, {"ini": 77.22, "fim": 78.28, "texto": "A 5,74", "palavras": [[77.22, 77.24, "A", 0.35], [77.28, 77.46, "5", 0.95], [77.48, 78.28, ",74", 1.0]]}, {"ini": 78.81, "fim": 82.09, "texto": "Vamos parar de só querer olhar para as boas oportunidades", "palavras": [[78.81, 78.95, "Vamos", 0.7], [78.99, 79.23, "parar", 1.0], [79.27, 79.33, "de", 1.0], [79.37, 79.45, "só", 1.0], [79.53, 79.77, "querer", 0.99], [79.79, 79.99, "olhar", 0.99], [80.43, 80.55, "para", 0.69], [80.57, 80.65, "as", 1.0], [80.83, 81.21, "boas", 1.0], [81.27, 82.09, "oportunidades", 0.98]]}, {"ini": 82.39, "fim": 83.27, "texto": "Quando elas acabam", "palavras": [[82.39, 82.55, "Quando", 1.0], [82.57, 82.75, "elas", 1.0], [82.79, 83.27, "acabam", 1.0]]}, {"ini": 83.99, "fim": 86.05, "texto": "Vamos começar a estudar mais", "palavras": [[83.99, 84.19, "Vamos", 1.0], [84.23, 84.79, "começar", 1.0], [84.97, 84.99, "a", 0.98], [85.07, 85.61, "estudar", 1.0], [85.69, 86.05, "mais", 0.93]]}, {"ini": 86.55, "fim": 87.55, "texto": "A inteligência financeira", "palavras": [[86.55, 86.57, "A", 0.99], [86.61, 87.07, "inteligência", 1.0], [87.07, 87.55, "financeira", 1.0]]}, {"ini": 87.84,