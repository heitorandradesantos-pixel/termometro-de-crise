[{"ini": 0.02, "fim": 2.46, "texto": "Pessoal, bora bater um papo de bêbado aqui com vocês agora.", "palavras": [[0.02, 0.26, "Pessoal,", 1.0], [0.26, 0.4, "bora", 1.0], [0.44, 0.68, "bater", 1.0], [0.72, 0.76, "um", 1.0], [0.8, 1.04, "papo", 1.0], [1.06, 1.14, "de", 1.0], [1.2, 1.54, "bêbado", 0.99], [1.56, 1.7, "aqui", 1.0], [1.76, 1.86, "com", 1.0], [1.9, 2.16, "vocês", 1.0], [2.2, 2.46, "agora.", 1.0]]}, {"ini": 2.78, "fim": 3.06, "texto": "Vamos lá.", "palavras": [[2.78, 2.98, "Vamos", 0.99], [2.98, 3.06, "lá.", 1.0]]}, {"ini": 3.84, "fim": 5.05, "texto": "Galera, loucura.", "palavras": [[3.84, 4.16, "Galera,", 1.0], [4.65, 5.05, "loucura.", 1.0]]}, {"ini": 5.65, "fim": 8.55, "texto": "Hoje, na tua situação financeira de qualquer pessoa,", "palavras": [[5.65, 5.87, "Hoje,", 1.0], [5.91, 6.01, "na", 1.0], [6.35, 6.49, "tua", 0.28], [6.57, 7.13, "situação", 1.0], [7.27, 7.77, "financeira", 1.0], [7.79, 7.85, "de", 0.84], [7.85, 8.09, "qualquer", 1.0], [8.11, 8.55, "pessoa,", 1.0]]}, {"ini": 9.07, "fim": 12.35, "texto": "seja ela rico, pobre, médio, muito rico,", "palavras": [[9.07, 9.27, "seja", 1.0], [9.35, 9.51, "ela", 1.0], [9.69, 9.97, "rico,", 0.7], [10.23, 10.59, "pobre,", 1.0], [11.11, 11.47, "médio,", 0.99], [11.83, 12.05, "muito", 1.0], [12.09, 12.35, "rico,", 1.0]]}, {"ini": 12.95, "fim": 15.14, "texto": "ela tem duas opções financeiramente falando.", "palavras": [[12.95, 13.05, "ela", 1.0], [13.05, 13.17, "tem", 1.0], [13.21, 13.37, "duas", 1.0], [13.43, 13.86, "opções", 1.0], [14.0, 14.72, "financeiramente", 0.99], [14.74, 15.14, "falando.", 1.0]]}, {"ini": 15.98, "fim": 17.86, "texto": "Educar ou ser educado.", "palavras": [[15.98, 16.44, "Educar", 0.99], [17.0, 17.08, "ou", 1.0], [17.2, 17.34, "ser", 1.0], [17.36, 17.86, "educado.", 1.0]]}, {"ini": 18.52, "fim": 20.0, "texto": "O que você prefere hoje? Comenta aqui embaixo.", "palavras": [[18.52, 18.54, "O", 1.0], [18.58, 18.66, "que", 1.0], [18.7, 18.88, "você", 1.0], [18.94, 19.28, "prefere", 1.0]