[{"ini": 0.12, "fim": 3.16, "texto": "Cara, olha a loucura que tá acontecendo no Brasil.", "palavras": [[0.12, 0.32, "Cara,", 0.99], [0.46, 0.62, "olha", 1.0], [0.66, 0.68, "a", 1.0], [0.84, 1.44, "loucura", 1.0], [1.7, 1.8, "que", 1.0], [1.92, 2.02, "tá", 0.7], [2.08, 2.64, "acontecendo", 1.0], [2.68, 2.74, "no", 1.0], [2.76, 3.16, "Brasil.", 1.0]]}, {"ini": 3.54, "fim": 5.87, "texto": "Quem comprou tesouro pré-fixado, viu?", "palavras": [[3.54, 3.7, "Quem", 1.0], [3.78, 4.16, "comprou", 1.0], [4.22, 4.56, "tesouro", 0.94], [4.94, 5.08, "pré", 0.34], [5.17, 5.69, "-fixado,", 1.0], [5.75, 5.87, "viu?", 1.0]]}, {"ini": 5.93, "fim": 7.99, "texto": "Ele perdeu cerca de 1,2% num dia.", "palavras": [[5.93, 6.03, "Ele", 1.0], [6.05, 6.29, "perdeu", 0.79], [6.35, 6.55, "cerca", 0.9], [6.61, 6.69, "de", 1.0], [6.83, 6.91, "1", 1.0], [7.19, 7.31, ",2", 0.91], [7.33, 7.61, "%", 1.0], [7.63, 7.75, "num", 0.99], [7.79, 7.99, "dia.", 1.0]]}, {"ini": 8.53, "fim": 11.21, "texto": "Pré-fixado é aquele que já te disse quanto vai render.", "palavras": [[8.53, 8.63, "Pré", 1.0], [8.69, 9.19, "-fixado", 1.0], [9.31, 9.33, "é", 1.0], [9.37, 9.61, "aquele", 1.0], [9.61, 9.69, "que", 1.0], [9.73, 9.81, "já", 1.0], [9.89, 9.99, "te", 1.0], [10.05, 10.27, "disse", 0.95], [10.37, 10.71, "quanto", 1.0], [10.75, 10.87, "vai", 1.0], [10.93, 11.21, "render.", 1.0]]}, {"ini": 11.65, "fim": 14.21, "texto": "Foi na segunda-feira, dia 16 de novembro, segundo o tesouro.", "palavras": [[11.65, 11.77, "Foi", 1.0], [11.79, 11.85, "na", 1.0], [11.97, 12.31, "segunda", 1.0], [12.35, 12.55, "-feira,", 1.0], [12.57, 12.65, "dia", 1.0], [12.69, 13.11, "16", 1.0], [13.13, 13.17, "de", 0.72], [13.17, 13.45, "novembro,", 0.82], [13.49, 13.75, "segundo", 0.99], [13.77, 13.79, "o", 0.91], [13.79, 14.21, "tesouro.", 0.89]]}, {"ini": 14.55, "fim": 17.24, "texto": "De manhã, a taxa Selic estava 15,26%.", "palavras": [[14.55, 14.65, "De", 1.0], [14.71, 14.93, "manhã,", 1.0], [15.03, 15.05, "a", 1.0], [15.11, 15.38, "