14, 17.0, ",92%.", 0.97]]}, {"ini": 17.0, "fim": 20.38, "texto": "Na pessoa física, segundo a XP, foi de 6% para 9,14%.", "palavras": [[17.0, 17.28, "Na", 1.0], [17.28, 17.46, "pessoa", 1.0], [17.46, 17.76, "física,", 1.0], [17.8, 18.0, "segundo", 0.87], [18.0, 18.1, "a", 1.0], [18.1, 18.22, "XP,", 1.0], [18.4, 18.54, "foi", 1.0], [18.54, 18.64, "de", 1.0], [18.64, 18.98, "6", 1.0], [18.98, 19.06, "%", 0.68], [19.06, 19.2, "para", 1.0], [19.2, 19.48, "9", 1.0], [19.48, 20.38, ",14%.", 1.0]]}, {"ini": 20.38, "fim": 24.96, "texto": "É a loja que vendeu fiado demais e o cliente não paga. E a loja separa dinheiro para cobrir o buraco.", "palavras": [[20.38, 20.88, "É", 1.0], [20.88, 20.96, "a", 1.0], [20.96, 21.24, "loja", 1.0], [21.24, 21.36, "que", 1.0], [21.36, 21.6, "vendeu", 1.0], [21.6, 21.92, "fiado", 1.0], [21.92, 22.08, "demais", 1.0], [22.08, 22.3, "e", 1.0], [22.3, 22.36, "o", 1.0], [22.36, 22.64, "cliente", 1.0], [22.64, 22.8, "não", 1.0], [22.8, 23.22, "paga.", 1.0], [23.28, 23.44, "E", 1.0], [23.44, 23.54, "a", 1.0], [23.54, 23.66, "loja", 1.0], [23.66, 24.02, "separa", 0.69], [24.02, 24.12, "dinheiro", 1.0], [24.12, 24.32, "para", 0.99], [24.32, 24.56, "cobrir", 1.0], [24.56, 24.6, "o", 1.0], [24.6, 24.96, "buraco.", 1.0]]}, {"ini": 25.04, "fim": 27.52, "texto": "No Banco do Brasil foi 21 bilhões no último trimestre.", "palavras": [[25.04, 25.28, "No", 1.0], [25.28, 25.46, "Banco", 1.0], [25.46, 25.52, "do", 1.0], [25.52, 25.74, "Brasil", 1.0], [25.74, 25.94, "foi", 0.68], [25.94, 26.32, "21", 0.95], [26.32, 26.88, "bilhões", 1.0], [26.88, 27.0, "no", 1.0], [27.0, 27.12, "último", 1.0], [27.12, 27.52, "trimestre.", 1.0]]}, {"ini": 27.52, "fim": 29.3, "texto": "Mas o que derrubou a ação foi outra coisa.", "palavras": [[27.52, 27.92, "Mas", 0.95], [27.92, 28.08, "o", 1.0], [28.08, 28.12, "que", 1.0], [28.12, 28.44, "derrubou", 0.98], [28.44, 28.54, "a", 1.0], [28.54, 28.74, "ação", 1.0], [28.74, 28.86, "foi", 1.0], [28.86, 29.06, "outra", 1.0], [29.06, 29.3