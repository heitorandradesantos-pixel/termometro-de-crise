[{"ini": 0.34, "fim": 3.98, "texto": "Meu Deus, aonde isso vai parar, meu povo?", "palavras": [[0.34, 1.02, "Meu", 0.98], [1.16, 1.7, "Deus,", 1.0], [1.8, 2.24, "aonde", 1.0], [2.3, 2.56, "isso", 1.0], [2.66, 2.82, "vai", 1.0], [2.9, 3.22, "parar,", 1.0], [3.38, 3.52, "meu", 1.0], [3.62, 3.98, "povo?", 1.0]]}, {"ini": 4.02, "fim": 6.87, "texto": "O dólar ontem fechando a 5,87.", "palavras": [[4.02, 4.04, "O", 1.0], [4.06, 4.44, "dólar", 1.0], [4.54, 4.78, "ontem", 1.0], [4.8, 5.35, "fechando", 1.0], [5.47, 5.49, "a", 1.0], [5.63, 5.87, "5", 0.92], [5.93, 6.87, ",87.", 1.0]]}, {"ini": 7.27, "fim": 12.21, "texto": "5,87 é o maior valor desde abril do ano passado e a quinta alta seguida.", "palavras": [[7.27, 7.69, "5", 1.0], [7.71, 8.65, ",87", 1.0], [8.67, 8.69, "é", 0.86], [8.73, 8.75, "o", 1.0], [8.79, 9.09, "maior", 1.0], [9.13, 9.43, "valor", 1.0], [9.49, 9.73, "desde", 1.0], [9.79, 10.01, "abril", 1.0], [10.03, 10.09, "do", 1.0], [10.11, 10.19, "ano", 1.0], [10.21, 10.63, "passado", 1.0], [10.95, 10.97, "e", 0.78], [11.05, 11.07, "a", 1.0], [11.27, 11.63, "quinta", 1.0], [11.69, 11.87, "alta", 0.99], [11.93, 12.21, "seguida.", 0.85]]}, {"ini": 12.25, "fim": 16.96, "texto": "O Banco Central vendeu 1 bilhão de dólares de manhã pra segurar, mas não segurou.", "palavras": [[12.25, 12.27, "O", 1.0], [12.31, 12.49, "Banco", 1.0], [12.51, 12.79, "Central", 1.0], [12.81, 13.05, "vendeu", 1.0], [13.27, 13.37, "1", 0.67], [13.63, 14.01, "bilhão", 1.0], [14.07, 14.15, "de", 1.0], [14.19, 14.57, "dólares", 1.0], [14.59, 14.67, "de", 1.0], [14.71, 14.91, "manhã", 1.0], [15.3, 15.4, "pra", 0.7], [15.52, 15.88, "segurar,", 1.0], [15.92, 16.14, "mas", 1.0], [16.42, 16.56, "não", 1.0], [16.62, 16.96, "segurou.", 1.0]]}, {"ini": 17.1, "fim": 22.12, "texto": "O motivo? Medo com as contas do governo, com ajuste fiscal travado no Senado.", "palavras": [[17.1, 17.12, "O", 0.99], [17.18, 17.58, "motivo?", 1.0], [18.0, 18.38, "Medo", 1.0], [18.42, 18.56, "com", 1.0], [18.58, 18.68, "as", 1.0], [18.72, 19.08, "contas", 1.0], [19.1, 19.16, "do", 1.0], [19.2, 19.72, "governo,", 1.0], [19.74, 19.86, "com", 1.0], [19.9, 20.32, "ajuste", 0.87], [20.34, 20.66, "fiscal", 1.0], [20.78, 21.58, "travado", 1.0], [21.62, 21.68, "no", 1.0], [21.74, 22.12, "Senado.", 1.0]]}, {"ini": 22.5, "fim": 23.8, "texto": "E o seu bolso, como fica?", "palavras": [[22.5, 22.52, "E", 1.0], [22.58, 22.6, "o", 1.0], [22.66, 22.78, "seu", 0.99], [22.82, 23.2, "bolso,", 1.0], [23.22, 23.4, "como", 1.0], [23.46, 23.8, "fica?", 1.0]]}, {"ini": 24.08, "fim": 28.31, "texto": "Uma compra de mil dólares no cartão com o IOF passa de 6 mil reais.", "palavras": [[24.08, 24.2, "Uma", 1.0], [24.26, 24.52, "compra", 1.0], [24.54, 24.62, "de", 1.0], [24.66, 24.82, "mil", 0.74], [24.86, 25.21, "dólares", 1.0], [25.23, 25.27, "no", 1.0], [25.29, 25.67, "cartão", 1.0], [25.93, 26.07, "com", 0.8], [26.07, 26.09, "o", 0.58], [26.13, 26.49, "IOF", 0.98], [26.69, 27.09, "passa", 1.0], [27.15, 27.25, "de", 1.0], [27.45, 27.83, "6", 0.91], [27.89, 27.99, "mil", 1.0], [28.03, 28.31, "reais.", 1.0]]}, {"ini": 28.35, "fim": 31.55, "texto": "Vai viajar? Não precisa comprar tudo no susto, num dia só.", "palavras": [[28.35, 28.45, "Vai", 0.82], [28.49, 28.81, "viajar?", 1.0], [29.33, 29.49, "Não", 1.0], [29.51, 29.79, "precisa", 1.0], [29.83, 30.11, "comprar", 1.0], [30.17, 30.39, "tudo", 0.99], [30.41, 30.47, "no", 0.97], [30.55, 30.89, "susto,", 1.0], [31.05, 31.17, "num", 0.99], [31.21, 31.35, "dia", 1.0], [31.45, 31.55, "só.", 1.0]]}, {"ini": 31.95, "fim": 34.91, "texto": "Chuta aí, o dólar chega a R$6 até o Natal ou não?", "palavras": [[31.95, 32.11, "Chuta", 1.0], [32.13, 32.25, "aí,", 1.0], [32.67, 32.69, "o", 1.0], [32.75, 33.05, "dólar", 1.0], [33.15, 33.43, "chega", 1.0], [33.45, 33.47, "a", 1.0], [33.69, 33.71, "R", 0.93], [33.75, 34.05, "$6", 0.91], [34.09, 34.25, "até", 0.69], [34.31, 34.33, "o", 1.0], [34.35, 34.65, "Natal", 0.99], [34.67, 34.71, "ou", 1.0], [34.75, 34.91, "não?", 1.0]]}, {"i