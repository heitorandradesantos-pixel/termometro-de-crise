[{"ini": 0.34, "fim": 5.35, "texto": "Lembra daquela quedinha do tesouro? Agora, olha o quanto ele deu de lucro em um dia.", "palavras": [[0.34, 0.62, "Lembra", 0.99], [0.66, 1.1, "daquela", 1.0], [1.48, 2.0, "quedinha", 0.94], [2.08, 2.14, "do", 1.0], [2.22, 2.72, "tesouro?", 0.91], [3.48, 3.9, "Agora,", 1.0], [3.96, 4.08, "olha", 1.0], [4.08, 4.1, "o", 1.0], [4.12, 4.32, "quanto", 1.0], [4.34, 4.46, "ele", 1.0], [4.5, 4.6, "deu", 1.0], [4.64, 4.7, "de", 1.0], [4.76, 4.99, "lucro", 1.0], [4.99, 5.03, "em", 1.0], [5.07, 5.11, "um", 1.0], [5.15, 5.35, "dia.", 1.0]]}, {"ini": 5.99, "fim": 10.85, "texto": "Lembra do tesouro que perdeu dinheiro num dia só? Pois ontem, aconteceu o contrário.", "palavras": [[5.99, 6.21, "Lembra", 1.0], [6.25, 6.33, "do", 1.0], [6.37, 6.95, "tesouro", 1.0], [7.29, 7.39, "que", 1.0], [7.47, 7.75, "perdeu", 1.0], [7.79, 8.19, "dinheiro", 0.99], [8.23, 8.35, "num", 0.91], [8.37, 8.55, "dia", 1.0], [8.65, 8.75, "só?", 1.0], [9.13, 9.35, "Pois", 1.0], [9.47, 9.71, "ontem,", 0.99], [9.87, 10.31, "aconteceu", 1.0], [10.33, 10.35, "o", 1.0], [10.37, 10.85, "contrário.", 1.0]]}, {"ini": 11.35, "fim": 18.56, "texto": "As taxas do tesouro despencaram. O Prefixado 2029 estava pagando R$15,33 na quinta.", "palavras": [[11.35, 11.47, "As", 1.0], [11.57, 11.93, "taxas", 1.0], [11.95, 12.01, "do", 1.0], [12.05, 12.51, "tesouro", 1.0], [13.41, 14.03, "despencaram.", 0.99], [14.43, 14.45, "O", 1.0], [14.49, 15.06, "Prefixado", 0.56], [15.06, 15.66, "2029", 0.85], [15.7, 15.88, "estava", 0.66], [15.92, 16.3, "pagando", 1.0], [16.3, 16.32, "R", 0.72], [16.42, 17.26, "$15", 0.82], [17.36, 17.92, ",33", 1.0], [17.96, 18.02, "na", 0.99], [18.16, 18.56, "quinta.", 1.0]]}, {"ini": 19.0, "fim": 26.29, "texto": "Ontem de manhã caiu para R$14,87. E quando a taxa cai, o título que você já tem, vale mais.", "palavras": [[19.0, 19.22, "Ontem", 1.0], [19.24, 19.3, "de", 1.0], [19.34, 19.5, "manhã", 1.0], [19.54, 19.7, "caiu", 0.91], [19.72, 19.8, "para", 0.92], [19.8, 19.82, "R", 1.0], [19.82, 19.96, "$14", 1.0], [19.96, 21.26, ",87.", 1.0], [21.74, 21.76, "E", 1.0], [21.8, 21.96, "quando", 1.0], [22.0, 22.02, "a", 1.0], [22.04, 22.32, "taxa", 1.0], [22.44, 22.74, "cai,", 1.0], [23.18, 23.2, "o", 1.0], [23.26, 23.54, "título", 1.0], [23.58, 23.66, "que", 1.0], [23.72, 23.98, "você", 1.0], [24.18, 24.32, "já", 1.0], [24.53, 24.79, "tem,", 1.0], [25.81, 25.97, "vale", 1.0], [25.99, 26.29, "mais.", 1.0]]}, {"ini": 26.83, "fim": 31.67, "texto": "Mas, 10 mil reais no tesouro longo ganharam 112 reais em um dia.", "palavras": [[26.83, 26.89, "Mas,", 0.42], [26.89, 27.07, "10", 0.75], [27.11, 27.21, "mil", 0.99], [27.27, 27.55, "reais", 1.0], [27.59, 27.63, "no", 0.78], [27.67, 28.01, "tesouro", 0.87], [28.11, 28.49, "longo", 1.0], [28.85, 29.25, "ganharam", 0.86], [29.81, 30.57, "112", 0.82], [30.61, 31.01, "reais", 1.0], [31.07, 31.13, "em", 1.0], [31.23, 31.29, "um", 0.99], [31.37, 31.67, "dia.", 1.0]]}, {"ini": 32.43, "fim": 32.91, "texto": "O motivo?", "palavras": [[32.43, 32.45, "O", 0.99], [32.49, 32.91, "motivo?", 1.0]]}, {"ini": 33.27, "fim": 37.52, "texto": "A Câmara aprovou o ajuste fiscal e o mercado respirou.", "palavras": [[33.27, 33.29, "A", 1.0], [33.37, 33.63, "Câmara", 0.93], [33.71, 34.13, "aprovou", 1.0], [34.16, 34.18, "o", 0.99], [34.18, 34.46, "ajuste", 1.0], [34.46, 34.88, "fiscal", 1.0], [35.32, 35.34, "e", 0.95], [35.38, 35.4, "o", 1.0], [35.42, 35.9, "mercado", 1.0], [37.08, 37.52, "respirou.", 1.0]]}, {"ini": 38.08, "fim": 39.5, "texto": "E aí vem a parte que ninguém te conta.", "palavras": [[38.08, 38.1, "E", 1.0], [38.12, 38.16, "aí", 1.0], [38.18, 38.26, "vem", 0.99], [38.3, 38.32, "a", 1.0], [38.4, 38.62, "parte", 1.0], [38.64, 38.7, "que", 1.0], [38.72, 38.92, "ninguém", 1.0], [38.94, 39.04, "te", 1.0], [39.1, 39.5, "conta.", 1.0]]}, {"ini": 40.02, "fim": 43.97, "texto": "Esse lucro só vira dinheiro no seu bolso se você vender antes.", "palavras": [[40.02, 40.16, "Esse", 1.0], [40.2, 40.46, "lucro", 1.0], [