[{"ini": 0.04, "fim": 4.1, "texto": "Amigo, se você tem carro a diesel, abastece ele hoje,", "palavras": [[0.04, 0.38, "Amigo,", 0.99], [0.98, 1.06, "se", 1.0], [1.12, 1.36, "você", 1.0], [1.46, 1.62, "tem", 1.0], [1.72, 1.98, "carro", 1.0], [2.02, 2.04, "a", 1.0], [2.12, 2.54, "diesel,", 0.99], [3.06, 3.62, "abastece", 1.0], [3.68, 3.8, "ele", 0.99], [3.84, 4.1, "hoje,", 1.0]]}, {"ini": 4.16, "fim": 8.68, "texto": "porque tecnicamente o desconto do diesel acaba amanhã.", "palavras": [[4.16, 4.4, "porque", 1.0], [4.54, 5.36, "tecnicamente", 0.96], [6.04, 6.06, "o", 0.9], [6.14, 6.8, "desconto", 1.0], [6.86, 6.96, "do", 1.0], [7.06, 7.5, "diesel", 1.0], [7.54, 8.04, "acaba", 1.0], [8.26, 8.68, "amanhã.", 1.0]]}, {"ini": 9.52, "fim": 11.49, "texto": "Presta atenção nessa data.", "palavras": [[9.52, 9.77, "Presta", 0.89], [9.79, 10.07, "atenção", 1.0], [10.09, 10.31, "nessa", 1.0], [10.37, 11.49, "data.", 1.0]]}, {"ini": 12.09, "fim": 15.29, "texto": "Amanhã, quinta-feira, vence o subsídio do diesel.", "palavras": [[12.09, 12.41, "Amanhã,", 1.0], [12.71, 13.05, "quinta", 0.98], [13.17, 13.43, "-feira,", 1.0], [13.87, 14.15, "vence", 0.99], [14.17, 14.19, "o", 1.0], [14.25, 14.79, "subsídio", 1.0], [14.83, 14.89, "do", 1.0], [14.95, 15.29, "diesel.", 1.0]]}, {"ini": 15.55, "fim": 19.19, "texto": "R$2,12 por litro para segurar o preço.", "palavras": [[15.55, 15.57, "R", 0.9], [15.73, 16.43, "$2", 0.72], [16.61, 17.09, ",12", 1.0], [17.63, 17.77, "por", 1.0], [17.83, 18.09, "litro", 1.0], [18.11, 18.29, "para", 0.92], [18.35, 18.71, "segurar", 1.0], [18.77, 18.79, "o", 1.0], [18.85, 19.19, "preço.", 1.0]]}, {"ini": 19.7, "fim": 20.86, "texto": "R$2,12.", "palavras": [[19.7, 19.72, "R", 0.85], [19.72, 20.06, "$2", 1.0], [20.52, 20.86, ",12.", 1.0]]}, {"ini": 21.32, "fim": 28.58, "texto": "O diesel tá custando em média uns 7 reais na bomba, ou seja, esse desconto é quase um terço do preço.", "palavras": [[21.32, 21.34, "O", 0.9], [21.44, 21.76, "diesel", 0.99], [21.8, 21.88, "tá", 0.29], [21.94, 22.32, "custando", 1.0], [22.32, 22.38, "em", 0.61], [22.44, 22.86, "média", 1.0], [23.28, 23.4, "uns", 0.98], [23.56, 23.88, "7", 0.71], [23.92, 24.22, "reais", 1.0], [24.26, 24.34, "na", 1.0], [24.4, 24.72, "bomba,", 1.0], [25.02, 25.12, "ou", 1.0], [25.32, 25.7, "seja,", 1.0], [26.16, 26.38, "esse", 1.0], [26.42, 26.84, "desconto", 1.0], [26.9, 26.92, "é", 1.0], [26.98, 27.38, "quase", 1.0], [27.48, 27.56, "um", 0.76], [27.68, 28.04, "terço", 1.0], [28.08, 28.14, "do", 1.0], [28.2, 28.58, "preço.", 1.0]]}, {"ini": 29.09, "fim": 33.03, "texto": "E até ontem o governo não tinha anunciado se vai renovar o desconto ou não.", "palavras": [[29.09, 29.11, "E", 1.0], [29.21, 29.45, "até", 1.0], [29.63, 29.89, "ontem", 1.0], [29.91, 29.95, "o", 1.0], [29.97, 30.39, "governo", 1.0], [30.53, 30.75, "não", 1.0], [30.81, 30.99, "tinha", 1.0], [31.01, 31.53, "anunciado", 1.0], [31.59, 31.67, "se", 1.0], [31.71, 31.87, "vai", 1.0], [31.93, 32.37, "renovar", 1.0], [32.43, 32.45, "o", 1.0], [32.47, 32.85, "desconto", 1.0], [32.87, 32.91, "ou", 0.99], [32.91, 33.03, "não.", 1.0]]}, {"ini": 33.49, "fim": 36.87, "texto": "O motivo? Petróleo subiu bastante lá fora.", "palavras": [[33.49, 33.51, "O", 1.0], [33.55, 33.93, "motivo?", 1.0], [34.71, 35.15, "Petróleo", 0.86], [35.23, 35.63, "subiu", 1.0], [35.71, 36.35, "bastante", 1.0], [36.47, 36.53, "lá", 1.0], [36.61, 36.87, "fora.", 1.0]]}, {"ini": 37.63, "fim": 40.08, "texto": "E aí vem a parte que ninguém te conta.", "palavras": [[37.63, 37.65, "E", 1.0], [37.71, 37.77, "aí", 1.0], [37.81, 37.91, "vem", 1.0], [37.93, 37.95, "a", 1.0], [38.03, 38.37, "parte", 1.0], [38.77, 38.9, "que", 1.0], [39.1, 39.5, "ninguém", 1.0], [39.54, 39.64, "te", 1.0], [39.72, 40.08, "conta.", 1.0]]}, {"ini": 40.54, "fim": 44.44, "texto": "Você não abastece caminhão, mas come o que o caminhão traz pra você.", "palavras": [[40.54, 40.76, "Você", 1.0], [40.8, 40.9, "não", 1.0], [40.94, 41.48, "abastece", 1.0], [41.5, 41.92, "caminhão,", 1.0], [42.38, 42.62, "mas", 1.0], [42.76, 43.02, "come", 0.99], [43.04, 43.06, "o", 1.0], [43.08, 43.14, "que", 1.0], [43.14, 43.16, "o", 0.99], [43.22, 43.66, "caminhão", 1.0], [43.74, 44.0, "traz", 1.0], [44.02, 44.14, "pra", 0.99], [44.18, 44.44, "você.", 1.0]]}, {"ini": 45.14, "fim": 47.16, "texto": "Diesel mais caro vira frete mais caro", "palavras": [[45.14, 45.44, "Diesel", 0.21], [45.48, 45.64, "mais", 1.0], [45.7, 45.96, "caro", 1.0], [46.0, 46.18, "vira", 0.96], [46.3, 46.64, "frete", 1.0], [46.68, 46.84, "mais", 1.0], [46.9, 47.16, "caro", 0.97]]}, {"ini": 47.42, "fim": 51.91, "texto": "E frete mais caro vira comida mais cara, infelizmente, no mercado", "palavras": [[47.42, 47.44, "E", 0.18], [47.54, 47.84, "frete", 1.0], [47.88, 48.04, "mais", 1.0], [48.1, 48.34, "caro", 0.99], [48.4, 48.59, "vira", 0.99], [49.11, 49.55, "comida", 0.74], [50.11, 50.29, "mais", 0.76], [50.35, 50.61, "cara,", 1.0], [50.69, 51.33, "infelizmente,", 1.0], [51.37, 51.43, "no", 1.0], [51.45, 51.91, "mercado", 1.0]]}, {"ini": 52.51, "fim": 55.95, "texto": "E manter também custa bilhões do caixa do governo", "palavras": [[52.51, 52.53, "E", 1.0], [52.63, 53.07, "manter", 1.0], [53.13, 53.55, "também", 0.99], [53.81, 54.17, "custa", 0.99], [54.45, 54.99, "bilhões", 1.0], [55.03, 55.09, "do", 1.0], [55.15, 55.45, "caixa", 1.0], [55.47, 55.53, "do", 1.0], [55.55, 55.95, "governo", 1.0]]}, {"ini": 56.35, "fim": 57.07, "texto": "Comenta aqui embaixo", "palavras": [[56.35, 56.55, "Comenta", 1.0], [56.57, 56.65, "aqui", 1.0], [56.65, 57.07, "embaixo", 1.0]]}, {"ini": 57.51, "fim": 59.22, "texto": "O governo renova ou não esse subsídio?", "palavras": [[57.51, 57.53, "O", 0.54], [57.55, 57.87, "governo", 1.0], [57.91, 58.29, "renova", 1.0], [58.32, 58.36, "ou", 1.0], [58.38, 58.48, "não", 1.0], [58.52, 58.64, "esse", 1.0], [58.7, 59.22, "subsídio?", 1.0]]}, {"ini": 59.66, "fim": 61.54, "texto": "Sem alarde, eu sou só o termômetro", "palavras": [[59.66, 59.8, "Sem", 0.94], [59.86, 60.28, "alarde,", 0.61], [60.5, 60.58, "eu", 1.0], [60.62, 60.74, "sou", 1.0], [60.82, 60.9, "só", 0.96], [60.94, 60.96, "o", 0.92], [61.0, 61.54, "termômetro", 1.0]]}]